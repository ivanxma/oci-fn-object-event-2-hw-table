# Minimal local deployment input. This file is git-ignored and must be mode 0600.
# OCI compartment, region, AD, subnet, namespace, and registry endpoint are
# discovered from the deployment VM by deploy/oci_context.sh.

# Mandatory: Object Storage bucket used as the default for new mappings.
export OBJECT_STORAGE_BUCKET_NAME=''

# Mandatory for silent deployment after setup has created the Vault secret.
# The secret content is never placed in this file.
export DB_SECRET_OCID=''

# Defaults; setup may override them while creating stream_hw_secret_key.
export CONTROL_DATABASE='stream_db'
export STREAM_DATA_DB_NAME='stream_data'
export STAGING_DATABASE='staging_db'

# Consistent versioned images. Tags must be immutable for a released build.
export REPOSITORY_PREFIX='object-storage-heatwave'
export PROCESSOR_IMAGE_NAME='object-storage-stream-processor'
export PROCESSOR_IMAGE_TAG=''
export UI_IMAGE_NAME='object-storage-heatwave-ui'
export UI_IMAGE_TAG=''

# Generated by setup_env.sh when omitted. Keep private and never reuse a DB credential.
export FLASK_SECRET_KEY=''

# Optional safe overrides for non-default deployment topology or TLS.
export OCI_REGISTRY_REPOSITORY=''
export UI_SERVER_NAME='_'
export GENERATE_SELF_SIGNED_CERT='true'
export TLS_CERT_FILE=''
export TLS_KEY_FILE=''
