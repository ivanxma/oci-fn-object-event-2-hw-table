# Local deployment values. Copy to env.sh or run ./deploy/setup_env.sh.
# env.sh is git-ignored and must remain mode 0600.

# ---------------------------------------------------------------------------
# Mandatory deployment settings
# ---------------------------------------------------------------------------
# OCI compartment in which the UI manages Streams, Events rules, Container
# Instances, Vault metadata, and repositories.
export COMPARTMENT_ID=''
# Region name and OCIR region key, for example uk-london-1 and lhr.
export REGION=''
export REGION_KEY=''
# Processor network and placement.
export SUBNET_ID=''
export CONTAINER_AVAILABILITY_DOMAIN=''
# Existing OCI Vault database JSON secret consumed by the processor.
export DB_SECRET_OCID=''
# OCIR repository path, immutable image tag, and full image reference.
export REPOSITORY_PREFIX=''
export PROCESSOR_IMAGE_TAG=''
export PROCESSOR_IMAGE_URL=''
# Generate a long random value; never reuse a database or OCI credential.
export FLASK_SECRET_KEY=''

# ---------------------------------------------------------------------------
# Selected topology metadata
# ---------------------------------------------------------------------------
# Optional at runtime. setup_env.sh records these selections so operators can
# audit the chosen network and can preselect the Vault/key used to create or
# rotate a database secret from the UI.
export VCN_ID=''
export VAULT_ID=''
export VAULT_KEY_ID=''

# ---------------------------------------------------------------------------
# Defaults — override only when the deployment requires different values
# ---------------------------------------------------------------------------
export PROCESSOR_IMAGE_NAME='object-storage-stream-processor' # Default image name.
export PROCESSOR_CONTAINER_NAME_PREFIX='object-storage-stream-processor' # Default managed-instance name prefix.
export PROCESSOR_SHAPE='CI.Standard.E4.Flex' # Default Container Instance shape.
export PROCESSOR_OCPUS='1' # Default processor OCPUs.
export PROCESSOR_MEMORY_GBS='16' # Default processor memory.
export WRITER_WORKERS='4' # Default parallel MySQL insert workers; valid range 1..32.
export BATCH_ROWS='10000' # Default rows per database insert batch.
export OBJECT_STORAGE_RANGE_BYTES='33554432' # Default 32 MiB bounded Object Storage range.
export OBJECT_STORAGE_READ_TIMEOUT_SECONDS='300' # Default SDK read timeout.
export PROCESSOR_PROCESSING_LEASE_SECONDS='300' # Must exceed the longest expected load.
export PROCESSOR_MAX_RETRIES='10' # Reserved operational retry limit.
export PROCESSOR_RETRY_BACKOFF_SECONDS='5' # Initial retry delay.
export PROCESSOR_HEALTH_PORT='8081' # Reserved processor health endpoint.
export OCI_AUTH_MODE='resource_principal' # Container runtime; VM checks override to instance_principal.

# The UI needs schema names for control and durable-message pages. These must
# match control_database and stream_data_database inside the Vault JSON secret.
export CONTROL_DATABASE='stream_db'
export STREAM_DATA_DB_NAME='stream_data'

export OCI_EVENT_RULE_MANAGEMENT_ENABLED='true' # Allow UI Events-rule management.
export OCI_STREAMING_MANAGEMENT_ENABLED='true' # Allow UI Stream management.
export OCI_CONTAINER_ORCHESTRATION_ENABLED='true' # Allow UI Container Instance management.
export OCI_EVENT_RULE_PREFIX='object-event-2-table' # Default managed rule prefix.

export UI_SERVICE_NAME='object-storage-heatwave-ui' # Default systemd service.
export UI_CONTAINER_NAME='object-storage-heatwave-ui' # Default local UI container.
export UI_BIND_PORT='8080' # Nginx proxies HTTPS to this localhost port.
export UI_SERVER_NAME='_' # Replace with the production DNS name when available.
export GENERATE_SELF_SIGNED_CERT='false' # Set true only for non-production validation.

# ---------------------------------------------------------------------------
# Optional values
# ---------------------------------------------------------------------------
# Use a CA-signed certificate in production. Leave both blank only when
# GENERATE_SELF_SIGNED_CERT=true.
export TLS_CERT_FILE=''
export TLS_KEY_FILE=''

# Optional Object Storage mapping defaults. The UI can configure these later.
export OBJECT_STORAGE_NAMESPACE=''
export OBJECT_STORAGE_BUCKET_NAME=''
export OBJECT_STORAGE_OBJECT_NAME_PATTERN=''
export RULE_NAME='object-event-2-table-events'

# Optional non-secret database form/display defaults. They are not required to
# deploy the UI or processor: processor connectivity comes only from
# DB_SECRET_OCID, and no database credential belongs in env.sh.
export DB_HOST=''
export DB_PORT='3306'
export DB_USER=''
export DB_NAME=''
export DB_SSL_DISABLED='false'

# Mapping-specific direct CLI deployment. Leave blank when deploying from the
# Event Processor UI; fill these only before deploy/deploy_processor.sh.
export OCI_STREAM_ID=''
export PROCESSING_MODE='FIFO'
export EXPECTED_PARTITION_COUNT='1'
export PROCESSOR_REPLICA_COUNT='1'
export PROCESSOR_PARTITIONS='0'
export PROCESSOR_MAPPING_ID=''

# Optional disposable parallel-flow verifier inputs.
export FLOW_MANAGED_STREAM='false' # Set true for a fully disposable fresh Stream per run.
export PARALLEL_STREAM_ID=''
export PARALLEL_TARGET_DATABASE=''
export PARALLEL_CSV_PATH=''
