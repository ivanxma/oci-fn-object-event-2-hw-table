# Copy to env.sh, fill locally, and chmod 600 env.sh. Never commit env.sh.
export COMPARTMENT_ID=''
export SUBNET_ID=''
export REGION=''
export REGION_KEY=''
export REPOSITORY_PREFIX=''
export DB_HOST=''
export DB_PORT='3306'
export DB_USER=''
# Control schema holding Object Storage-to-Stream mappings.
# DB_NAME is retained for compatibility with earlier deployment settings.
export DB_NAME='fndb3'
# Dedicated durable stream archive: payloads, offsets/checkpoints, status, and
# retry history. Defaults to DB_NAME only for backward compatibility.
export STREAM_DATA_DB_NAME='stream_data'
export CONTROL_DATABASE='fndb3'
# Allow the UI to create, list, update, and delete OCI Events rules that target
# the selected Stream. The Compute instance dynamic group needs scoped
# `manage cloudevents-rules` permission in this compartment.
export OCI_EVENT_RULE_MANAGEMENT_ENABLED='true'
export OCI_STREAMING_MANAGEMENT_ENABLED='true'
export OCI_CONTAINER_ORCHESTRATION_ENABLED='false'
export DB_SECRET_OCID=''
export CONTAINER_AVAILABILITY_DOMAIN=''
export PROCESSOR_IMAGE_NAME='object-storage-stream-processor'
export PROCESSOR_IMAGE_TAG=''
export PROCESSOR_IMAGE_URL=''
export PROCESSOR_CONTAINER_NAME_PREFIX='object-storage-stream-processor'
export PROCESSOR_SHAPE=''
export PROCESSOR_OCPUS=''
export PROCESSOR_MEMORY_GBS=''
export PROCESSOR_HEALTH_PORT='8081'
export PROCESSOR_MAX_RETRIES='10'
export PROCESSOR_RETRY_BACKOFF_SECONDS='5'
# After this lease a PROCESSING capture from an interrupted processor is safely
# returned to FAILED and retried. Keep this above the longest expected load.
export PROCESSOR_PROCESSING_LEASE_SECONDS='300'
# Mapping-specific inputs supplied to deploy/deploy_processor.sh. Each Container
# Instance owns explicit, disjoint stream partitions; no automatic assignment
# is assumed. Run one deployment per assignment, for example 0 and 1,2.
export OCI_STREAM_ID=''
export PROCESSING_MODE='FIFO'
export EXPECTED_PARTITION_COUNT='1'
export PROCESSOR_REPLICA_COUNT='1'
export PROCESSOR_PARTITIONS='0'
# Control-database mapping identifier used only as non-secret OCI resource
# metadata for Flow and Event Processor drill-down.
export PROCESSOR_MAPPING_ID=''
# Disposable two-partition verifier inputs. Keep its target separate from
# production data; PARALLEL_CSV_PATH must reference a known-schema CSV.
export PARALLEL_STREAM_ID=''
export PARALLEL_TARGET_DATABASE=''
export PARALLEL_CSV_PATH=''
# Leave at resource_principal for OCI Container Instances. Set
# instance_principal only for a bounded VM smoke test.
export OCI_AUTH_MODE='resource_principal'
export OCI_EVENT_RULE_PREFIX='object-event-2-table'
export DB_SSL_DISABLED='false'
export OBJECT_STORAGE_NAMESPACE=''
export BATCH_ROWS='10000'
export WRITER_WORKERS='4'
# Per-read SDK timeout for the processor's Object Storage loader.
export OBJECT_STORAGE_READ_TIMEOUT_SECONDS='300'
# Maximum bytes fetched per Object Storage HTTP Range response. This bounds
# memory use and avoids a single response exceeding the platform lifetime.
export OBJECT_STORAGE_RANGE_BYTES='33554432'
# Restrict the Events rule to one bucket when required; blank means all buckets.
export OBJECT_STORAGE_BUCKET_NAME=''
# Optional OCI Events object-name filter. Object Storage folders are prefixes
# in the object name. Example: `myfolder/*.csv`; blank means every object.
export OBJECT_STORAGE_OBJECT_NAME_PATTERN=''
export RULE_NAME='object-event-2-table-events'

# Flask UI HTTPS deployment (used by deploy/deploy_ui.sh).
# Set this to a long random value and keep env.sh mode 0600.
export FLASK_SECRET_KEY=''
export UI_SERVICE_NAME='object-storage-heatwave-ui'
export UI_CONTAINER_NAME='object-storage-heatwave-ui'
# Nginx serves public HTTPS on 443 and proxies to this localhost-only port.
export UI_BIND_PORT='8080'
export UI_SERVER_NAME='_'
# Set paths to a CA-signed certificate and private key, or explicitly allow a
# temporary self-signed certificate for testing.
export TLS_CERT_FILE=''
export TLS_KEY_FILE=''
export GENERATE_SELF_SIGNED_CERT='false'
